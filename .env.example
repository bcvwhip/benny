# GEMINI_API_KEY: Required for Gemini AI API calls (fallback if Mistral key is not set).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MISTRAL_API_KEY: Central AI Engine API key for 3 athlas.
MISTRAL_API_KEY=""

# MISTRAL_MODEL: Default Mistral model (e.g. mistral-small-latest, mistral-large-latest, open-mistral-7b, codestral-latest)
MISTRAL_MODEL="mistral-small-latest"

# DATABASE_URL: Optional database connection string (defaults to persistent local database storage)
DATABASE_URL=""

# AUTH_SECRET: JWT authentication secret for user sessions
AUTH_SECRET="athlas-secret-key-change-in-production"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

